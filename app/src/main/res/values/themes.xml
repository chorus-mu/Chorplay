    </style>
    <style name="Theme.Chorplay.Starting.Black.Dynamic" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dynamic_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Chorplay</item>
    </style>

    <!-- Material icons: launcher foreground over the icon tint, one base per icon. -->
    <style name="Theme.Chorplay.Starting.Material.Sky" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_material_sky</item>
        <item name="postSplashScreenTheme">@style/Theme.Chorplay</item>
    </style>
    <style name="Theme.Chorplay.Starting.Material.Mint" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_material_mint</item>
        <item name="postSplashScreenTheme">@style/Theme.Chorplay</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Material.Sky" parent="Theme.Chorplay.Starting.Material.Sky">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Material.Mint" parent="Theme.Chorplay.Starting.Material.Mint">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Material.Sky" parent="Theme.Chorplay.Starting.Material.Sky">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Material.Mint" parent="Theme.Chorplay.Starting.Material.Mint">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
    </style>
    <style name="Theme.Chorplay.Starting.Black.Material.Sky" parent="Theme.Chorplay.Starting.Material.Sky">
        <item name="windowSplashScreenBackground">@color/splash_background_black</item>
    </style>
    <style name="Theme.Chorplay.Starting.Black.Material.Mint" parent="Theme.Chorplay.Starting.Material.Mint">
        <item name="windowSplashScreenBackground">@color/splash_background_black</item>
    </style>

    <!-- Expressive icons: their own art at logo size over the tone's window, like the Chorplay badge. -->
    <style name="Theme.Chorplay.Starting.Light.Expressive" />
    <style name="Theme.Chorplay.Starting.Light.Expressive.Scallop">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_scallop</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Expressive.Segmented">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_segmented</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Expressive.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_play</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Expressive.Sky">
