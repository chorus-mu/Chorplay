    </style>
    <style name="Theme.Chorplay.Starting.Light.Expressive.Pill">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_pill</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Expressive" />
    <style name="Theme.Chorplay.Starting.Dark.Expressive.Scallop">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_scallop</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Expressive.Segmented">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_segmented</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Expressive.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_play</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Expressive.Sky">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_sky</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Expressive.Mint">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_mint</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Expressive.Cookie">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_cookie</item>
