    </style>
    <style name="Theme.Chorplay.Starting.Light.Expressive.Cookie">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_expressive_cookie</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Expressive.Oval">
