<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Chorplay" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Enable edge-to-edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <!-- The window is a platform Light theme whatever Chorplay's own theme is, so a system or MIUI
             dark mode would otherwise invert what Compose already drew dark or light (#1517). -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- The platform splash. Before Android 13 it follows the system night mode; from 13 on,
         SplashController picks one of the styles below so each launch matches the app theme
         and launcher icon the user chose. -->
    <style name="Theme.Chorplay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Chorplay</item>
    </style>

    <style name="Theme.Chorplay.Starting.Light">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_chorplay_play</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Amoled">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_amoled_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Monochrome">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_monochrome_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Light.Dynamic" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dynamic_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Chorplay</item>
    </style>

    <style name="Theme.Chorplay.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_chorplay_play</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Amoled">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_amoled_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Monochrome">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_monochrome_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Ghost">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_ghost_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Dark.Dynamic" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_dynamic_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/icon_bg_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Chorplay</item>
    </style>

    <style name="Theme.Chorplay.Starting.Black">
        <item name="windowSplashScreenBackground">@color/splash_background_black</item>
    </style>
    <style name="Theme.Chorplay.Starting.Black.Play">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_fg_chorplay_play</item>
    </style>
    <style name="Theme.Chorplay.Starting.Black.Amoled">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_amoled_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Black.Monochrome">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_monochrome_inset</item>
    </style>
    <style name="Theme.Chorplay.Starting.Black.Ghost">
